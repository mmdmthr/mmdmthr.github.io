---
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { render } from 'astro:content';
import { calculateReadingTime } from '../../utils/readingTime';
import { findRelatedArticles } from '../../utils/relatedArticles';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

// Get all posts for related articles and navigation
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Get raw body for reading time calculation
const rawBody = post.body || '';
const readingTimeInfo = calculateReadingTime(rawBody);

// Find related articles
const relatedArticles = findRelatedArticles(post, allPosts, 3);

// Find previous and next articles (based on publication date)
const currentIndex = sortedPosts.findIndex((p) => p.id === post.id);
const nextArticle = sortedPosts[currentIndex + 1];
const previousArticle = sortedPosts[currentIndex - 1];
---

<BlogPost 
	{...post.data} 
	readingTime={readingTimeInfo}
	relatedArticles={relatedArticles}
	previousArticle={previousArticle}
	nextArticle={nextArticle}
>
	<Content />
</BlogPost>
