---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import Search from "astro-pagefind/components/Search";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const posts = allPosts.sort(
	(a, b) =>
		new Date(b.data.pubDate).getTime() -
		new Date(a.data.pubDate).getTime(),
);

// Get unique categories
const categories = Array.from(
	new Set(posts.map((p) => p.data.category).filter(Boolean))
);

// Group posts by category
const postsByCategory = categories.reduce(
	(acc, category) => {
		acc[category!] = posts.filter((p) => p.data.category === category);
		return acc;
	},
	{} as Record<string, typeof posts>
);

// Posts without category
const uncategorizedPosts = posts.filter((p) => !p.data.category);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `Blog - ${SITE_TITLE}`,
  description: SITE_DESCRIPTION,
  url: 'https://mmdmthr.github.io/blog/',
  author: {
    '@type': 'Person',
    name: 'Hari',
    url: 'https://mmdmthr.github.io/',
  },
};

const categoryDescriptions: Record<string, string> = {
	Build: 'Things I built and what I learned while building them.',
	Understand: 'Technical concepts I explored because I wanted to know how they actually work.',
	Think: 'Lessons and reflections from software, work, learning, and building.',
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead title={`Blog - ${SITE_TITLE}`} description="All blog posts — notes on software development, engineering practices, and lessons learned from building real software." />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body
    class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen"
  >
    <Header />

    <main class="content-container py-12 md:py-16">
      <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <header class="mb-12">
          <h1 class="text-3xl sm:text-4xl font-bold mb-4">Writing</h1>
          <p class="text-lg text-gray-600 dark:text-gray-400">
            A collection of things I've built, things I've investigated, and things I've learned.
          </p>
        </header>

        <!-- Search -->
        <section class="mb-12">
          <Search
            id="search"
            className="pagefind-ui"
            uiOptions={{
              showImages: false,
              showSubResults: true,
            }}
          />
        </section>

        <!-- Posts by Category -->
        {
          categories.map((category) => (
            <section class="mb-16">
              <div class="mb-8">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">
                  {category}
                </h2>
                {categoryDescriptions[category] && (
                  <p class="text-gray-600 dark:text-gray-400">
                    {categoryDescriptions[category]}
                  </p>
                )}
              </div>

              <div class="space-y-6">
                {postsByCategory[category].map((post) => (
                  <article class="border-b border-gray-200 dark:border-gray-800 pb-6 last:border-b-0">
                    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-3">
                      <h3 class="text-lg font-semibold">
                        <a
                          href={`/blog/${post.id}/`}
                          class="text-gray-900 dark:text-gray-100 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-200"
                        >
                          {post.data.title}
                        </a>
                      </h3>
                      <time class="text-sm text-gray-500 dark:text-gray-400 flex-shrink-0">
                        <FormattedDate date={post.data.pubDate} />
                      </time>
                    </div>

                    {post.data.description && (
                      <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed mb-3">
                        {post.data.description}
                      </p>
                    )}

                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="flex flex-wrap gap-2">
                        {post.data.tags.map((tag) => (
                          <span class="inline-block px-2 py-1 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded text-xs">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </article>
                ))}
              </div>
            </section>
          ))
        }

        <!-- Uncategorized Posts -->
        {
          uncategorizedPosts.length > 0 && (
            <section class="mb-16">
              <div class="mb-8">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">
                  All Writing
                </h2>
                <p class="text-gray-600 dark:text-gray-400">
                  Additional articles and notes.
                </p>
              </div>

              <div class="space-y-6">
                {uncategorizedPosts.map((post) => (
                  <article class="border-b border-gray-200 dark:border-gray-800 pb-6 last:border-b-0">
                    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-3">
                      <h3 class="text-lg font-semibold">
                        <a
                          href={`/blog/${post.id}/`}
                          class="text-gray-900 dark:text-gray-100 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-200"
                        >
                          {post.data.title}
                        </a>
                      </h3>
                      <time class="text-sm text-gray-500 dark:text-gray-400 flex-shrink-0">
                        <FormattedDate date={post.data.pubDate} />
                      </time>
                    </div>

                    {post.data.description && (
                      <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed mb-3">
                        {post.data.description}
                      </p>
                    )}

                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="flex flex-wrap gap-2">
                        {post.data.tags.map((tag) => (
                          <span class="inline-block px-2 py-1 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded text-xs">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </article>
                ))}
              </div>
            </section>
          )
        }

        <!-- Empty State -->
        {
          posts.length === 0 && (
            <section class="text-center py-16">
              <p class="text-gray-600 dark:text-gray-400">
                No articles yet. Check back soon!
              </p>
            </section>
          )
        }
      </div>
    </main>

    <Footer />
  </body>
</html>
