---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ArticleOutline from '../components/ArticleOutline';
import RelatedArticles from '../components/RelatedArticles.astro';
import PreviousNext from '../components/PreviousNext.astro';
import { SITE_TITLE } from '../consts';

interface Props extends CollectionEntry<'blog'>['data'] {
	readingTime?: {
		minutes: number;
		display: string;
	};
	relatedArticles?: CollectionEntry<'blog'>[];
	previousArticle?: CollectionEntry<'blog'>;
	nextArticle?: CollectionEntry<'blog'>;
}

const { 
	title, 
	description, 
	pubDate, 
	updatedDate, 
	category, 
	tags, 
	series, 
	readingTime,
	relatedArticles = [],
	previousArticle,
	nextArticle,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	...(description && { description }),
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	url: canonicalURL.toString(),
	author: {
		'@type': 'Person',
		name: 'Hari',
		url: Astro.site?.toString(),
	},
	publisher: {
		'@type': 'Person',
		name: SITE_TITLE,
		url: Astro.site?.toString(),
	},
	...(tags && tags.length > 0 && { keywords: tags.join(', ') }),
};

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: Astro.site?.toString(),
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Blog',
			item: new URL('/blog/', Astro.site).toString(),
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: title,
			item: canonicalURL.toString(),
		},
	],
};
---

<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={title} description={description} ogType="article" pubDate={pubDate} updatedDate={updatedDate} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
	</head>

	<body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen">
		<Header />
		<main class="content-container py-8">
			<div class="lg:grid lg:grid-cols-4 lg:gap-8">				
				<!-- Article column -->
				<article class="blog-post lg:col-span-3 max-w-3xl" data-pagefind-body>
					<!-- Mobile outline toggle -->
					<div class="lg:hidden mb-8">
						<ArticleOutline client:load articleSelector="article.blog-post" />
					</div>
				<!-- Article Header -->
				<header class="mb-8">

					<!-- Series Info -->
					{series && (
						<div class="mb-4 text-sm text-gray-600 dark:text-gray-400 italic">
							{series.name} • Part {series.part}
						</div>
					)}

					<h1
						class="text-xl sm:text-2xl lg:text-3xl font-bold text-gray-900 dark:text-gray-100 leading-tight mb-6"
						data-pagefind-meta="title"
					>
						{title}
					</h1>

					<!-- Category and Tags -->
					<div class="mb-4 flex flex-wrap items-center justify-center gap-2">
						{category && (
							<span class="inline-block px-3 py-1 bg-primary-100 dark:bg-primary-900 text-primary-700 dark:text-primary-300 rounded-full text-sm font-medium">
								{category}
							</span>
						)}
						{tags && tags.length > 0 && (
							tags.map((tag) => (
								<span class="inline-block px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-full text-sm">
									{tag}
								</span>
							))
						)}
					</div>

					<div class="mb-4">
						<span class="text-sm text-gray-500 dark:text-gray-400">
							<FormattedDate date={pubDate} />
						</span>
						{updatedDate && (
							<span>•</span>
							<span class="text-sm text-gray-500 dark:text-gray-400 italic mt-1">
								Last updated on <FormattedDate date={updatedDate} />
							</span>
						)}
						{readingTime && (
							<span>•</span>
							<span class="text-sm text-gray-500 dark:text-gray-400 mt-1">
								{readingTime.display}
							</span>
						)}
					</div>

					{description && (
						<p
						  class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed"
						  data-pagefind-meta="description"
						>
							{description}
						</p>
					)}

					<hr class="w-16 h-0.5 bg-primary-500 border-0 mx-auto mt-6" />
				</header>

				<!-- Article Content -->
				<div class="prose-vitesse">
					<slot />
				</div>

				<!-- Related Articles and Navigation -->
				<RelatedArticles relatedArticles={relatedArticles} />
				<PreviousNext {previousArticle} {nextArticle} />
			</article>

			<!-- Right column: Desktop outline -->
			<div class="hidden lg:block">
				<ArticleOutline client:load articleSelector="article.blog-post" />
			</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
