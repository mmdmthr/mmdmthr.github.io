---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	previousArticle?: CollectionEntry<'blog'>;
	nextArticle?: CollectionEntry<'blog'>;
}

const { previousArticle, nextArticle } = Astro.props;

if (!previousArticle && !nextArticle) {
	return null;
}
---

<nav
	class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700 grid grid-cols-2 gap-4"
	aria-label="Article navigation"
>
	{previousArticle ? (
		<a
			href={`/blog/${previousArticle.id}/`}
			class="flex flex-col gap-2 p-4 rounded-lg bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors text-left"
		>
			<span class="text-xs font-semibold uppercase text-gray-500 dark:text-gray-400">← Previous</span>
			<h3 class="font-semibold text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors line-clamp-2">
				{previousArticle.data.title}
			</h3>
			<span class="text-xs text-gray-500 dark:text-gray-400">
				<FormattedDate date={previousArticle.data.pubDate} />
			</span>
		</a>
	) : (
		<div />
	)}

	{nextArticle ? (
		<a
			href={`/blog/${nextArticle.id}/`}
			class="flex flex-col gap-2 p-4 rounded-lg bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors text-right"
		>
			<span class="text-xs font-semibold uppercase text-gray-500 dark:text-gray-400">Next →</span>
			<p class="font-semibold text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors line-clamp-2">
				{nextArticle.data.title}
			</p>
			<span class="text-xs text-gray-500 dark:text-gray-400">
				<FormattedDate date={nextArticle.data.pubDate} />
			</span>
		</a>
	) : (
		<div />
	)}
</nav>
